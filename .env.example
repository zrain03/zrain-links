# Local development: set these in your shell or a private environment manager.
# Never commit real secrets. Do not rely on .env loading automatically.
SPRING_PROFILES_ACTIVE=local
ZRAIN_JWT_SECRET_BASE64=REPLACE_WITH_UNIQUE_RANDOM_BASE64_32_BYTE_KEY
ZRAIN_JWT_ISSUER=zrain-links
ZRAIN_JWT_AUDIENCE=zrain-links-api
ZRAIN_JWT_ACCESS_MINUTES=15
ZRAIN_LINKS_BASE_URL=http://localhost:8080

# Production PostgreSQL (required with SPRING_PROFILES_ACTIVE=prod):
# DB_JDBC_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
# DB_USERNAME=SET_IN_HOSTING_SECRET_MANAGER
# DB_PASSWORD=SET_IN_HOSTING_SECRET_MANAGER
# ZRAIN_LINKS_BASE_URL=https://YOUR-PUBLIC-DOMAIN
