{
  "name": "zrain-links-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/core.test.js test/auth-ui.test.js test/admin.test.js test/visits.test.js test/qr-preview.test.js test/zrain-ui.test.js test/section-nav.test.js",
    "build:pages": "node scripts/build-pages.mjs",
    "smoke": "node test/smoke.mjs",
    "ui:sync": "node scripts/sync-zrain-ui.mjs",
    "ui:check": "node scripts/sync-zrain-ui.mjs --check",
    "pretest": "npm run ui:check",
    "deploy:worker": "npm run ui:check && npm test && wrangler deploy"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "jose": "^6.1.0",
    "@zrain/ui": "github:zrain03/zrain-ui#af77e6782bdfa168296c1fe14061d72a1e400c55"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "zrainUi": {
    "publicDir": "public"
  }
}
